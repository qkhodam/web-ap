{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ap",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0b1faf3b-dcf6-4372-b187-664787f0ce59","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6a5e73984ffb4b9087824dba33d84f57" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
